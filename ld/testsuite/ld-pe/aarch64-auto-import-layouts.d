# The first five branches replace the imported ADRP instructions.  The
# instructions between each ADRP and its low relocation must survive:
# adjacent access, an unrelated mov, an interleaved local pair, and a
# prologue followed by two low relocations using the same page base.
#...
[ 	]*[0-9a-f]+:	[0-9a-f]+ 	b	.*
#...
[ 	]*[0-9a-f]+:	91000000 	add	x0, x0, #0x0
#...
[ 	]*[0-9a-f]+:	b9400000 	ldr	w0, \[x0\]
#...
[ 	]*[0-9a-f]+:	[0-9a-f]+ 	b	.*
#...
[ 	]*[0-9a-f]+:	d2800002 	mov	x2, #0x0.*
#...
[ 	]*[0-9a-f]+:	91000021 	add	x1, x1, #0x0
#...
[ 	]*[0-9a-f]+:	b9400021 	ldr	w1, \[x1\]
#...
[ 	]*[0-9a-f]+:	[0-9a-f]+ 	adrp	x2, .*
#...
[ 	]*[0-9a-f]+:	[0-9a-f]+ 	b	.*
#...
[ 	]*[0-9a-f]+:	91000042 	add	x2, x2, #0x0
#...
[ 	]*[0-9a-f]+:	91000063 	add	x3, x3, #0x0
#...
[ 	]*[0-9a-f]+:	b9400063 	ldr	w3, \[x3\]
#...
[ 	]*[0-9a-f]+:	[0-9a-f]+ 	b	.*
#...
[ 	]*[0-9a-f]+:	a9bf7bfd 	stp	x29, x30, \[sp, #-16\]!
#...
[ 	]*[0-9a-f]+:	91000085 	add	x5, x4, #0x0
#...
[ 	]*[0-9a-f]+:	b9400086 	ldr	w6, \[x4\]
#...
[ 	]*[0-9a-f]+:	[0-9a-f]+ 	b	.*
#...
[ 	]*[0-9a-f]+:	b94000e8 	ldr	w8, \[x7\]
#...
[ 	]*[0-9a-f]+:	b94000e9 	ldr	w9, \[x7\]
# Each imported page base gets an IAT-loading stub using its destination
# register and returning to the instruction after the original ADRP.
#...
[ 	]*[0-9a-f]+:	58000080 	ldr	x0, .*
